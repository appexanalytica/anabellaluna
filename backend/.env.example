MONGODB_URI=mongodb://<username>:<password>@host:27017/<database>?retryWrites=true&w=majority
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=please-change-this-secret
PORT=4000
NODE_ENV=development

# Optional: enable verbose DB logs (true/false)
DB_VERBOSE=false
PORT=4000

# MongoDB connection string. Replace <username>,<password>,<host>,<port>,<database> with your values.
# Example (Mongo Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://<username>:<password>@host:27017/<database>

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT secret used to sign tokens (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

STORAGE_PROVIDER=minio

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anabella
MINIO_BUCKET_CRM=anabellaluna-crm
MINIO_BUCKET_ERP=anabellaluna-erp
MINIO_BUCKET_WEB=anabellaluna-web
MINIO_REGION=

# Google Calendar OAuth (per-agent integration)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add GOOGLE_OAUTH_REDIRECT_URI to "Authorized redirect URIs"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/crm/integrations/google-calendar/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:3001/crm/integraciones?googleCalendar=connected
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# Web Push (VAPID keys) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@anabellaluna.com

# Admin credentials (used by seed.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Mapbox public token (pk.*) — single place to paste it: all frontends (sitio,
# admin, agents) fetch it at runtime from GET /public/maps-config.
# Optional per-app override: VITE_MAPBOX_TOKEN (frontend) / REACT_APP_MAPBOX_TOKEN (admin/agents).
MAPBOX_TOKEN=

# ── Mercado Libre integration ──────────────────────────────────────────────────
# Master AES-256 encryption key for ML credentials stored in MongoDB.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is the ONLY ML variable that lives in .env — all other ML credentials
# (CLIENT_ID, CLIENT_SECRET, REDIRECT_URI, WEBHOOK_URL) are configured from
# the admin panel (ERP → Integraciones → Mercado Libre) and stored encrypted in DB.
ML_ENCRYPTION_KEY=

# ── Redis — Requerido para Event Bus distribuido ───────────────────────────
# Sin Redis: los eventos de negocio solo se loguean localmente (modo degradado).
# Con Redis: el AI Gateway Python puede consumir eventos en tiempo real.
# Instalar localmente: redis-server  |  Docker: docker run -d -p 6379:6379 redis:7
REDIS_URL=redis://localhost:6379

# ── Service Auth — AI Gateway → Backend ──────────────────────────────────────
# Clave secreta para que microservicios internos (AI Gateway Python) llamen la API.
# Separada de los JWT de usuarios — nunca exponer al frontend.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_KEY=

# ── AI Gateway — Plataforma Cognitiva (Python/FastAPI, puerto 8100) ──────────
# URL donde corre el AI Gateway cognitivo (5 agentes IA, memory, workflows)
# En producción suele estar en el mismo servidor; el backend proxya /ai-gateway/* a esta URL
AI_GATEWAY_URL=http://localhost:8100

# ── OpenRouter — AI provider principal ──────────────────────────────────────
# Registrarse en https://openrouter.ai — API compatible OpenAI, múltiples modelos
# Modelos disponibles: openai/gpt-4o-mini (recomendado), anthropic/claude-3-haiku, etc.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini   (default si no se especifica)

# ── WhatsApp (Evolution API) ─────────────────────────────────────────────────
# Proveedor activo: 'evolution' (único soportado actualmente)
# Futuros: 'wppconnect', 'cloud' (Meta Cloud API)
WHATSAPP_PROVIDER=evolution

# URL donde corre Evolution API (instalado en el mismo servidor o en otro)
# Instalación Evolution API: https://doc.evolution-api.com/v2/en/get-started/introduction
# Docker: docker run -d -p 8080:8080 --name evolution-api atendai/evolution-api:latest
EVOLUTION_API_URL=http://localhost:8080

# API Key global de Evolution API
# Se configura en /etc/evolution-api/env o en el docker-compose de Evolution
# Debe coincidir exactamente con AUTHENTICATION_API_KEY en Evolution API
EVOLUTION_API_KEY=your_evolution_api_key_here

# URI PostgreSQL para Evolution API — deploy.sh la genera automáticamente si está vacía
# Formato: postgresql://usuario:password@localhost:5432/evolution_api?schema=evolution_api
EVOLUTION_DB_URI=

# URL pública del backend — Evolution API necesita poder hacer POST a este webhook
# Debe ser accesible desde internet (o desde donde corra Evolution API)
# Evolution API → Configurar webhook en cada instancia apuntando a esta URL
BACKEND_PUBLIC_URL=https://api.anabellaluna.com.ar

# Webhook de Evolution API (ruta fija, no cambiar salvo que modifiques routes/whatsapp.js)
# En Evolution API: WEBHOOK_URL = ${BACKEND_PUBLIC_URL}/whatsapp/webhook/evolution
# Se configura al crear cada sesión (lo hace EvolutionProvider automáticamente)

# (Opcional) Clave secreta para verificar que el webhook proviene de Evolution API.
# Si se define, Evolution debe enviar este valor en el header "apikey".
# Generarla con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# EVOLUTION_WEBHOOK_SECRET=