# MCP Server — Variables de entorno

# MongoDB (mismo que el backend)
MONGODB_URI=mongodb://localhost:27017/anabella

# URL interna del backend (para que las tools de escritura llamen la API)
BACKEND_INTERNAL_URL=http://localhost:4000

# Clave de autenticación interna — debe coincidir con INTERNAL_SERVICE_KEY del backend
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_KEY=
