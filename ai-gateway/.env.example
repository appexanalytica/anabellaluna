# ============================================================================
# AI Gateway — Variables de entorno
# Copiar como: cp .env.example .env
# ============================================================================

# ── Backend Node.js (source of truth) ──────────────────────────────────────
BACKEND_URL=http://localhost:4000
INTERNAL_SERVICE_KEY=<copiar mismo valor que backend/.env>

# ── PostgreSQL + pgvector (semantic memory) ────────────────────────────────
# Puerto 5432 = PostgreSQL nativo del servidor
# Puerto 5433 = PostgreSQL Docker (docker-compose.ai.yml)
DATABASE_URL=postgresql+asyncpg://ai_user:change_me@localhost:5432/anabella_ai

# ── Redis (event bus + cache) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM Provider ──────────────────────────────────────────────────────────
# OpenAI — misma key que usa el backend Node
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Langfuse (observability) ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3010

# ── Gateway config ────────────────────────────────────────────────────────
AI_GATEWAY_PORT=8100
LOG_LEVEL=info
ENVIRONMENT=development
